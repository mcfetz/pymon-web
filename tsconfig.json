{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "strict": false,
    "noEmit": true
  },
  "include": ["src/**/*.js", "src/**/*.svelte", "src/**/*.d.ts"]
}
